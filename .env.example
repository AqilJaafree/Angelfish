# --- RPC ---
# General-purpose endpoint: every eth_call, plus the Infinity sweep (which filters on
# the CLPoolManager address and so is unrestricted).
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_RPC_TIMEOUT_MS=30000

# Endpoint for the v3 sweep ONLY. That sweep is topic-only by design (no address
# filter — that is what makes a new pool visible on its first trade), and almost every
# free BSC endpoint refuses such a query. Measured across nine on 2026-08-15:
#   https://bsc.blockrazor.xyz          OK, 25-block getLogs cap  <- default
#   https://1rpc.io/bnb                 OK, 50-block cap
#   https://bsc-rpc.publicnode.com      -32701 "Please specify an address"
#   https://bsc-dataseed.bnbchain.org   -32005 limit exceeded
#   https://bsc.meowrpc.com             eth_getLogs is not supported
BSC_LOG_RPC_URL=https://bsc.blockrazor.xyz
# Largest block span per eth_getLogs on the sweep endpoint. Raise it on a paid
# endpoint — every increase is one fewer round-trip per cycle.
BSC_MAX_LOG_RANGE=25
# eth_calls sent per JSON-RPC batch. Batching is what makes the cycle viable here: a
# 300-block window surfaces 200-280 pools, and resolving them one call at a time
# measured 191s against a 120s poll. Batched, a cold cycle is ~43s.
BSC_MAX_BATCH=100

# --- Board knobs ---
# Rows per board. Raise MOVERS_MCAP_MAX_LOOKUPS with it: the market-cap walk has to
# fill two groups of this size (main + Danger Zone), so it cannot finish in fewer
# than 2x this many lookups.
MOVERS_TOP_N=8
# ~267 blocks at 0.45s/block, so a 300-block window gives continuous coverage.
MOVERS_POLL_SECONDS=120
# ~2.3 min of BSC. Also the catch-up clamp after downtime.
MOVERS_MAX_LOOKBACK_BLOCKS=300
MOVERS_MIN_MARKET_CAP_USD=300000
MOVERS_MCAP_MAX_LOOKUPS=40
# Largest per-swap fee treated as real, in pips (1e6 = 100%). Infinity hooks set the
# rate per swap and a live sample contained swaps reporting 980310 pips (98%).
MOVERS_MAX_FEE_PIPS=100000

# --- Ranking ---
# What the boards order on: 'swaps' (default) or 'spike'. Anything other than 'spike'
# reads as 'swaps'.
#   swaps  raw Swap-event count in the window, busiest pool first. Swap count is a
#          fairly stable property of a pool, so the leaders look similar cycle to
#          cycle. Ties break on USD volume; no warm-up, so a pool is rankable on its
#          first ever trade.
#   spike  window volume against that pool's OWN recent baseline. Keeps the board
#          turning over, but a pool that normally trades nothing can win on small
#          absolute numbers.
# Both are computed every cycle, so this changes the ORDER only, never what a row
# says about itself. Neither is shown on the Telegram row; the spike is printed by
# the stdout renderer so the ordering stays debuggable in the logs.
MOVERS_RANK_BY=swaps

# The two knobs below gate the SPIKE only, and so do nothing while MOVERS_RANK_BY is
# 'swaps' — except that an unscored row still renders as "(warming)" on stdout.
# Finalized buckets required before a pool is scoreable (~15 min at
# BLOCKS_PER_CANDLE=667); below this it ranks by volume behind every scored pool.
SPIKE_MIN_BUCKETS=3
# Minimum window volume in USD (18 decimals) to be eligible for a spike score. In USD
# rather than anchor units because a floor has to mean the same thing to every pool:
# "0.05 of the anchor" is $45 for a BNB pool and five cents for a USDT one.
SPIKE_MIN_VOLUME_USD=50000000000000000000

# --- Established-token filter ---
# Stablecoins, bridged majors and BNB-chain DeFi blue chips are excluded by address
# (see src/bsc/denylist.ts). Set to 0 to show them.
MOVERS_DENYLIST_ENABLED=1
# Extra addresses to exclude, comma-separated.
# MOVERS_DENYLIST=0x…,0x…
# Addresses to force back onto the boards, overriding the built-in list.
# MOVERS_ALLOWLIST=0x…

# --- RSI candles ---
# 667 blocks ~= 5 min at 0.45s/block, the same candle duration as the Ethereum build's
# 25 blocks — which is what matters, since RSI-14 is 14 five-minute candles either way.
BLOCKS_PER_CANDLE=667
# Volume floor gating RSI DISPLAY only (0 = disabled), in anchor base units.
MOVERS_RSI_MIN_VOLUME_ANCHOR=0

# --- Contract verification / audit ---
# There is NO Blockscout instance for BNB Chain, and BscScan's V1 API is retired, so
# two sources are tried in order.
#
# Sourcify needs NO KEY and covered 48 of 60 real board tokens (80%) when measured,
# so the badges work out of the box.
BSC_SOURCIFY_API=https://sourcify.dev/server
# Etherscan V2 covers what Sourcify lacks. OPTIONAL — the key is free from
# etherscan.io/apis, and without it this source is simply skipped.
BSC_EXPLORER_API=https://api.etherscan.io/v2/api
BSC_EXPLORER_CHAIN_ID=56
# BSC_EXPLORER_API_KEY=
# Human-facing explorer, used for the token links in Telegram messages.
BSC_EXPLORER_BASE=https://bscscan.com
MOVERS_AUDIT_ENABLED=1

# --- Telegram (indexer) ---
# Run `npm run chat-id` to discover the chat id — a bot cannot open a conversation,
# so message it first.
TELEGRAM_BOT=
TELEGRAM_CHAT_ID=
# Optional forum-topic thread ids. Unset => everything goes to the group's General
# topic, which is correct for a plain (non-forum) chat.
#
# There are two boards, both PancakeSwap v3, split by the currency the pair is quoted
# in — one topic each. The old names are read as fallbacks so an existing deployment
# lands on the same two topics without being edited: V3_MOVERS_TOPIC_ID routed the v3
# board (now the WBNB one) and V4_MOVERS_TOPIC_ID routed Infinity (now the USDT one).
# V3_WBNB_MOVERS_TOPIC_ID=       # falls back to V3_MOVERS_TOPIC_ID
# V3_USDT_MOVERS_TOPIC_ID=       # falls back to V4_MOVERS_TOPIC_ID
# DANGER_ZONE_TOPIC_ID=
# Setting this brings the PancakeSwap Infinity board back as a THIRD board on its own
# topic. Unset (the default) the Infinity worker does not run at all — it has no topic
# left to post to, and sweeping for rows nobody reads costs a cycle's RPC budget.
# INFINITY_MOVERS_TOPIC_ID=
# Set 0 to run the indexer without posting (stdout only).
TELEGRAM_ENABLED=1

# --- LP bot (a separate process: npm run start:lp) ---
KEEPERHUB_URL=https://app.keeperhub.com/mcp
# KEEPERHUB_API_KEY=kh_…
# The address behind the KeeperHub wallet integration. No default, on purpose.
# LP_WALLET_ADDRESS=
# NUMERIC Telegram id of the only account allowed to command the bot. Never a
# username: usernames are mutable and can be re-registered by someone else, so gating
# fund movement on one would hand the wallet to whoever claims it next. Unset resolves
# to 0, which no real account can have, so an unconfigured bot refuses everyone.
# LP_OWNER_TELEGRAM_ID=
# Optional, cross-checked to raise a log warning — never trusted for authorisation.
# LP_OWNER_USERNAME=
# How long a quoted plan stays confirmable (ms). Short, because the quote embeds a
# tick range derived from a price that moves.
LP_CONFIRM_TTL_MS=300000
# Default half-width of a position, in percent around the current price.
LP_DEFAULT_RANGE_PCT=10
# Slippage floor applied to amountMin.
LP_SLIPPAGE_PCT=1

# --- State ---
# Block cursor and caches. Mount a volume here to keep them across deploys.
# STATE_DIR=./tmp
