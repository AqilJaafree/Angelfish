# --- RPC ---
# Must permit a TOPIC-ONLY eth_getLogs (no `address` filter) — the v3 sweep has none.
# Verified working (2026-08-13):
#   https://eth-mainnet.public.blastapi.io   (10-block getLogs cap)
#   https://eth.drpc.org                     (10-block getLogs cap)
# Verified REJECTING topic-only queries: https://ethereum-rpc.publicnode.com
ETH_RPC_URL=https://eth-mainnet.public.blastapi.io
ETH_RPC_TIMEOUT_MS=30000
# Largest block span per eth_getLogs. Free endpoints cap this at 10; raise it on a
# paid endpoint (Alchemy/Infura allow far more) — every increase is one fewer
# round-trip per cycle.
ETH_MAX_LOG_RANGE=10

# --- Board knobs ---
MOVERS_TOP_N=5
# A full cycle measures ~73s on the free endpoint (warm cache), so 60 would fire
# mid-cycle every time. Lower this on a paid endpoint.
MOVERS_POLL_SECONDS=120
# ~12s/block, so 300 blocks ≈ 1h of catch-up after downtime.
MOVERS_MAX_LOOKBACK_BLOCKS=300
MOVERS_MIN_MARKET_CAP_USD=300000
MOVERS_MCAP_MAX_LOOKUPS=25

# --- Established-token filter ---
# Stablecoins, wrapped majors, LSTs and DeFi blue chips are excluded by address
# (see src/mainnet/denylist.ts). Set to 0 to show them.
MOVERS_DENYLIST_ENABLED=1
# Extra addresses to exclude, comma-separated.
# MOVERS_DENYLIST=0x…,0x…
# Addresses to force back onto the boards, overriding the built-in list.
# MOVERS_ALLOWLIST=0x…
# 25 blocks ≈ 5 min.
BLOCKS_PER_CANDLE=25
MOVERS_RSI_MIN_VOLUME_WEI=0

# --- Telegram ---
# Bot token. A bot cannot start a conversation, so the chat has to message it
# first: run `npm run chat-id`, send /start to the bot, and the chat id is
# discovered and written back here automatically.
TELEGRAM_BOT=
TELEGRAM_CHAT_ID=
# Set to 0 to index without posting (stdout only).
TELEGRAM_ENABLED=1
# Optional forum-topic thread ids. Unset => everything posts to the group's
# General topic, which is correct for an ordinary (non-forum) chat.
# V3_MOVERS_TOPIC_ID=
# V4_MOVERS_TOPIC_ID=
# DANGER_ZONE_TOPIC_ID=

# --- Explorer (contract verification + heuristic source scan) ---
ETH_EXPLORER_BASE=https://eth.blockscout.com
# Set to 0 to skip verification lookups entirely (one HTTP call per new token).
MOVERS_AUDIT_ENABLED=1

# --- Contract overrides (defaults are the verified mainnet addresses) ---
# ETH_WETH=0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2
# ETH_USDC=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
# ETH_USDC_WETH_POOL=0x88e6a0c2ddd26feeb64f039a2c41296fcb3f5640
# ETH_V3_FACTORY=0x1f98431c8ad98523631ae4a59f267346ea31f984
# ETH_V4_POOL_MANAGER=0x000000000004444c5dc75cb358380d2e3de08a90
# ETH_V4_POSITION_MANAGER=0xbd216513d74c8cf14cf4747e6aaa6420ff64ee9e
# ETH_V4_DEPLOY_BLOCK=21688329

LOG_LEVEL=info
STATE_DIR=./tmp
